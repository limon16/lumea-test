{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Замовлення",
    "description": "Замовлення з сайту. Залишки списуються одразу при створенні."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "customerName": {
      "type": "string",
      "required": true,
      "maxLength": 100,
      "description": "Імʼя покупця."
    },
    "phone": {
      "type": "string",
      "required": true,
      "maxLength": 30,
      "description": "Телефон для звʼязку."
    },
    "email": {
      "type": "email",
      "maxLength": 120,
      "description": "Email покупця, якщо вказав."
    },
    "comment": {
      "type": "text",
      "maxLength": 500,
      "description": "Побажання до замовлення."
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "confirmed",
        "cancelled"
      ],
      "default": "new",
      "required": true,
      "description": "«new» — щойно з сайту. «confirmed» — підтверджено. «cancelled» — скасовано, залишки повертаються на склад."
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "order.item",
      "required": true,
      "description": "Склад замовлення."
    },
    "total": {
      "type": "decimal",
      "required": true,
      "min": 0,
      "description": "Підсумкова сума, порахована на сервері."
    }
  }
}
