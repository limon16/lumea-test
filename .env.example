# Postgres
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=lumea
DATABASE_USERNAME=lumea
DATABASE_PASSWORD=lumea
DATABASE_SSL=false

# Strapi secrets (згенерувати: openssl rand -base64 32)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Web
NEXT_PUBLIC_STRAPI_URL=http://127.0.0.1:1337
# Local only. On Vercel set the final https:// domain or omit to use its system domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional internal CMS URL used by the Next.js server (public media still uses NEXT_PUBLIC_STRAPI_URL)
# STRAPI_URL=https://cms.example.com
# Additional public image/storage origins, comma-separated (Next.js build-time setting)
# IMAGE_ORIGINS=https://media.example.com
